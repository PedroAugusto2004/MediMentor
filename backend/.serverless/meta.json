              }
            }
          ],
          "environment": {
            "NODE_ENV": "production"
          },
          "name": "medimentor-dev-api"
        }
      },
      "plugins": [
        "serverless-offline"
      ],
      "custom": {
        "serverless-offline": {
          "httpPort": 3000
        }
      }
    },
